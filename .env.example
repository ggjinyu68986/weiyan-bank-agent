# 复制为 .env 并填写（.env 已被 .gitignore 排除，永不提交）
# DeepSeek（或任意 OpenAI 兼容服务：豆包/GPT 改 base_url+model 即可）

LLM_API_KEY=sk-你的key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- JEV 双引擎决策层（可选增强，默认 mock 离线可演示） ----
# JEV_MODE：off=纯规则（评测基线）| mock=确定性伪JEV+置信度（默认，演示不依赖网络）| live=真实JEV API
# JEV_MODE=live 时必须填 JEV_API_KEY（OpenRouter Key）。无 Key/网络失败自动回退 mock，绝不阻塞业务。
JEV_MODE=mock
JEV_API_KEY=
JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.13
